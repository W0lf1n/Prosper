# Copy to `.env` beside the compose file and fill both secrets in.
#
#     cp .env.example .env
#
# `.env` is git-ignored. Neither secret has a default: compose refuses to start
# without them rather than booting something that looks fine and is not.

# Postgres. Read once, at first start, when the volume is created — changing it
# afterwards does not change the password the database already has.
#
#     openssl rand -base64 32
POSTGRES_PASSWORD=

# The code a device types once, in Settings → Synchronizace, to be handed a
# token. It is not a password: it is short because it is typed on a phone, and
# it is the only thing standing between somebody and your ledger. Six digits is
# what the UI expects; more is better if you will not mistype it.
#
#     openssl rand -hex 4
PAIRING_CODE=

# Where the app answers on the host, for the host's nginx to proxy to. Change it
# if 8080 is already taken. It is bound to 127.0.0.1 either way.
PROSPER_PORT=8080
