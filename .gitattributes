# The repository is developed on Windows and deployed on Linux, and
# `core.autocrlf` is true here. That is fine for source — git normalises on
# commit — but the files below are read by programs that treat a carriage
# return as part of the line.
#
# A shell script checked out with CRLF fails as
# `/bin/sh^M: bad interpreter`, and it fails at 03:17 in a cron log nobody is
# reading. This is one line of insurance against that.

*.sh          text eol=lf
*.conf        text eol=lf
*.conf.example text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
